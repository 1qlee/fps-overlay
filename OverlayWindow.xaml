<Window x:Class="FpsOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Margin" Value="0,1,14,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#9AA4AE" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="52" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#C8CDD2" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="64" />
        </Style>
    </Window.Resources>

    <Border Background="#B0101418" CornerRadius="6" Padding="10,6,0,6">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="FPS" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" x:Name="FpsText" Text="–" />
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Detail}" x:Name="FrameTimeText" Text="" />
                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Detail}" x:Name="LowText" Text="" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="CPU" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="CpuTempText" Text="–" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Detail}" x:Name="CpuLoadText" Text="" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="GPU" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="GpuTempText" Text="–" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Detail}" x:Name="GpuLoadText" Text="" />
            </Grid>

            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#7E8890" Margin="0,3,10,0" Text="starting…" />
        </StackPanel>
    </Border>
</Window>

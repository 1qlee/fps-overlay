<Window x:Class="FpsOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False">

    <Window.Resources>
        <!-- Bahnschrift ships with Windows 10+; Segoe UI is the fallback. -->
        <FontFamily x:Key="OverlayFont">Bahnschrift, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="CpuColor" Color="#FF5C5C" />
        <SolidColorBrush x:Key="GpuColor" Color="#4ADE80" />
        <SolidColorBrush x:Key="FpsColor" Color="#4DA3FF" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Section label: CPU / GPU / FPS -->
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- A number with a small raised unit, e.g. 69°C or 305W -->
        <Style x:Key="Reading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style TargetType="Run" x:Key="Unit">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BaselineAlignment" Value="Superscript" />
        </Style>

        <!-- Space between the CPU, GPU and FPS groups -->
        <Style x:Key="Group" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border x:Name="Pill" Background="#E6080A0C" CornerRadius="22" Padding="22,8,12,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Style="{StaticResource Group}">
                    <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource CpuColor}" Text="CPU" />
                    <TextBlock Style="{StaticResource Reading}" MinWidth="50">
                        <Run x:Name="CpuTempValue" Text="–" /><Run x:Name="CpuTempUnit" Style="{StaticResource Unit}" Text="°C" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Reading}" MinWidth="50">
                        <Run x:Name="CpuPowerValue" Text="–" /><Run Style="{StaticResource Unit}" Text="W" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Style="{StaticResource Group}">
                    <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource GpuColor}" Text="GPU" />
                    <TextBlock Style="{StaticResource Reading}" MinWidth="50">
                        <Run x:Name="GpuTempValue" Text="–" /><Run x:Name="GpuTempUnit" Style="{StaticResource Unit}" Text="°C" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Reading}" MinWidth="62">
                        <Run x:Name="GpuPowerValue" Text="–" /><Run Style="{StaticResource Unit}" Text="W" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Style="{StaticResource Group}">
                    <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource FpsColor}" Text="FPS" />
                    <TextBlock Style="{StaticResource Reading}" x:Name="FpsText" MinWidth="40" Text="–" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Only shown when something is wrong (not elevated, sensors missing, ...). -->
        <TextBlock x:Name="StatusText" Visibility="Collapsed" FontSize="11" Foreground="#C8CDD2"
                   Margin="22,4,0,0" />
    </StackPanel>
</Window>
